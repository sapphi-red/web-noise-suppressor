{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:monthly",
    "group:allNonMajor",
    "helpers:disableTypesNodeMajor"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchDepTypes": ["action"],
      "pinDigests": true
    }
  ],
  "ignoreDeps": ["node", "@oxc-project/runtime"]
}
